{
  "cli": {
    "version": ">= 18.0.6",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development"
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://macrolet-express-production.up.railway.app"
      }
    },
    "beta": {
      "distribution": "store",
      "autoIncrement": true,
      "channel": "beta",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://macrolet-express-production.up.railway.app"
      }
    },
    "production": {
      "autoIncrement": true,
      "channel": "production",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://macrolet-express-production.up.railway.app"
      }
    }
  },
  "submit": {
    "production": {},
    "beta": {}
  }
}
